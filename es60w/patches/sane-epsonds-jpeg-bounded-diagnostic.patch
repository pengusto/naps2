+/* Private diagnostic: preserve the exact compressed input before any decoder
+ * drops rows. Opt-in, ES-60W only, private directory, fresh mode-0600 file.
+ * Never changes acquisition parameters or the selected page length. */
+static void
+eds_capture_es60w_jpeg(epsonds_scanner *s, const SANE_Byte *data, SANE_Int size,
+                       SANE_Int isBackSide)
+{
+    const char *dir = getenv("NAPS2_TEST_ES60W_CAPTURE_DIR");
+    struct stat info;
+    char path[PATH_MAX];
+    if (!dir || !*dir) return;
+    if (!s->hw->model || strcmp(s->hw->model, "ES-60W") != 0 ||
+        isBackSide || !data || size <= 0) return;
+    if (dir[0] != '/' || lstat(dir, &info) || !S_ISDIR(info.st_mode) ||
+        info.st_uid != getuid() || (info.st_mode & 077)) {
+        DBG(0, "ES-60W JPEG capture rejected: require owned private directory\n");
+        return;
+    }
+    int length = snprintf(path, sizeof path, "%s/es60w-input-XXXXXX", dir);
+    if (length < 0 || (size_t)length >= sizeof path) return;
+    int fd = mkstemp(path);
+    if (fd < 0) return;
+    size_t offset = 0;
+    while (offset < (size_t)size) {
+        ssize_t count = write(fd, data + offset, (size_t)size - offset);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) break;
+        offset += (size_t)count;
+    }
+    int closed = close(fd);
+    if (offset != (size_t)size || closed) { unlink(path); return; }
+    DBG(10, "ES-60W compressed input saved: %s bytes=%d\n", path, size);
+}
